def squeeze_excite_block(input_tensor, ratio=16):
    """
    SENet block
    Args:
        input_tensor (keras.tensor): Input tensor
        ratio (int): Reduction ratio
    Returns:
        keras.tensor: Output tensor
    """
    channel_axis = 1 if K.image_data_format() == "channels_first" else -1
    channel_count = input_tensor.get_shape()[channel_axis]

    se_feature = GlobalAveragePooling2D()(input_tensor)
    se_feature = Dense(channel_count // ratio, activation='relu', kernel_regularizer=l2(1e-5), use_bias=False)(se_feature)
    se_feature = Dense(channel_count, activation='sigmoid', kernel_regularizer=l2(1e-5), use_bias=False)(se_feature)
    x = Multiply()([input_tensor, se_feature])
    return x

class SENetLayer(Layer):
    def __init__(self, ratio=16, **kwargs):
        super(SENetLayer, self).__init__(**kwargs)
        self.ratio = ratio

    def build(self, input_shape):
        channel_axis = 1 if K.image_data_format() == "channels_first" else -1
        channel_count = input_shape[channel_axis]

        self.global_avg_pool = GlobalAveragePooling2D()
        self.dense_1 = Dense(channel_count // self.ratio, activation='relu', kernel_regularizer=l2(1e-5), use_bias=False)
        self.dense_2 = Dense(channel_count, activation='sigmoid', kernel_regularizer=l2(1e-5), use_bias=False)
        self.multiply = Multiply()
        super(SENetLayer, self).build(input_shape)

    def call(self, inputs):
        se_feature = self.global_avg_pool(inputs)
        se_feature = self.dense_1(se_feature)
        se_feature = self.dense_2(se_feature)
        x = self.multiply([inputs, se_feature])
        return x

    def get_config(self):
        config = super().get_config()
        config.update({"ratio": self.ratio})
        return config

